+++ b/examples/Robocasa_tabletop/eval_files/verify_seed_determinism.py
@@ -0,0 +1,60 @@
+"""Smoke-test that RoboCasa-GR1 resets are deterministic and seed-sensitive."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+import gymnasium as gym
+
+import robocasa  # noqa: F401
+from robocasa.utils.gym_utils import GrootRoboCasaEnv  # noqa: F401
+
+from examples.Robocasa_tabletop.eval_files.seed_manifest import TASK_NAMES
+from examples.Robocasa_tabletop.eval_files.simulation_env import hash_observation
+
+
+def reset_hash(env_name: str, seed: int) -> str:
+    env = gym.make(env_name, enable_render=True)
+    try:
+        observation, _ = env.reset(seed=seed)
+        return hash_observation(observation)
+    finally:
+        env.close()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--env-name", default=TASK_NAMES[0])
+    parser.add_argument("--seed", type=int, default=1203059356)
+    parser.add_argument("--different-seed", type=int, default=1189844044)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if os.environ.get("PYTHONHASHSEED") != "0":
+        raise RuntimeError("Set PYTHONHASHSEED=0 before starting this verification")
+    first_hash = reset_hash(args.env_name, args.seed)
+    repeated_hash = reset_hash(args.env_name, args.seed)
+    different_hash = reset_hash(args.env_name, args.different_seed)
+    report = {
+        "env_name": args.env_name,
+        "seed": args.seed,
+        "different_seed": args.different_seed,
+        "first_hash": first_hash,
+        "repeated_hash": repeated_hash,
+        "different_hash": different_hash,
+        "same_seed_deterministic": first_hash == repeated_hash,
+        "different_seed_changes_observation": first_hash != different_hash,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("w", encoding="utf-8") as file:
+        json.dump(report, file, indent=2)
+        file.write("\n")
+    print(json.dumps(report, indent=2))
+    if not report["same_seed_deterministic"] or not report["different_seed_changes_observation"]:
+        raise RuntimeError("RoboCasa-GR1 seed determinism verification failed")
+
+
+if __name__ == "__main__":
+    main()
