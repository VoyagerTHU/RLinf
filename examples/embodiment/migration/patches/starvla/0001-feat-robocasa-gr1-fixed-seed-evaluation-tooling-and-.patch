@@ -0,0 +1,63 @@
+"""Validate and summarize a complete fixed-seed RoboCasa-GR1 evaluation."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+
+from examples.Robocasa_tabletop.eval_files.seed_manifest import TASK_NAMES, load_manifest
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--results-dir", type=Path, required=True)
+    parser.add_argument("--seed-manifest", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    manifest = load_manifest(args.seed_manifest)
+    task_results = {}
+    all_successes = []
+    for task_name in TASK_NAMES:
+        task_slug = task_name.split("/", 1)[1]
+        result_path = args.results_dir / f"{task_slug}.json"
+        with result_path.open(encoding="utf-8") as file:
+            result = json.load(file)
+        expected_seeds = manifest["tasks"][task_name]
+        actual_seeds = [episode["seed"] for episode in result["episodes"]]
+        if actual_seeds != expected_seeds:
+            raise ValueError(f"Seed mismatch for {task_name}")
+        successes = [bool(episode["success"]) for episode in result["episodes"]]
+        if len(successes) != manifest["episodes_per_task"]:
+            raise ValueError(f"Episode count mismatch for {task_name}")
+        observation_hashes = [episode.get("initial_observation_sha256") for episode in result["episodes"]]
+        if not all(isinstance(value, str) and len(value) == 64 for value in observation_hashes):
+            raise ValueError(f"Missing initial observation hash for {task_name}")
+        task_results[task_name] = {
+            "successes": int(sum(successes)),
+            "episodes": len(successes),
+            "success_rate": float(np.mean(successes)),
+            "unique_initial_observations": len(set(observation_hashes)),
+        }
+        all_successes.extend(successes)
+    summary = {
+        "seed_manifest_sha256": hashlib.sha256(args.seed_manifest.read_bytes()).hexdigest(),
+        "num_tasks": len(TASK_NAMES),
+        "episodes_per_task": manifest["episodes_per_task"],
+        "total_episodes": len(all_successes),
+        "macro_success_rate": float(np.mean([item["success_rate"] for item in task_results.values()])),
+        "total_success_rate": float(np.mean(all_successes)),
+        "tasks": task_results,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("w", encoding="utf-8") as file:
+        json.dump(summary, file, indent=2)
+        file.write("\n")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
