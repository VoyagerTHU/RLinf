@@ -0,0 +1,146 @@
+"""Generate and validate deterministic RoboCasa-GR1 evaluation seed manifests."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import random
+from pathlib import Path
+from typing import Any
+
+
+TASK_NAMES = (
+    "gr1_unified/PnPCupToDrawerClose_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PnPPotatoToMicrowaveClose_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PnPMilkToMicrowaveClose_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PnPBottleToCabinetClose_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PnPWineToCabinetClose_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PnPCanToDrawerClose_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromCuttingboardToBasketSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromCuttingboardToCardboardboxSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromCuttingboardToPanSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromCuttingboardToPotSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromCuttingboardToTieredbasketSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromPlacematToBasketSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromPlacematToBowlSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromPlacematToPlateSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromPlacematToTieredshelfSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromPlateToBowlSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromPlateToCardboardboxSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromPlateToPanSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromPlateToPlateSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromTrayToCardboardboxSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromTrayToPlateSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromTrayToPotSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromTrayToTieredbasketSplitA_GR1ArmsAndWaistFourierHands_Env",
+    "gr1_unified/PosttrainPnPNovelFromTrayToTieredshelfSplitA_GR1ArmsAndWaistFourierHands_Env",
+)
+
+
+def _task_rng(base_seed: int, task_name: str) -> random.Random:
+    digest = hashlib.sha256(f"{base_seed}:{task_name}".encode()).digest()
+    return random.Random(int.from_bytes(digest[:8], byteorder="big", signed=False))
+
+
+def generate_manifest(base_seed: int = 20260819, episodes_per_task: int = 50) -> dict[str, Any]:
+    """Return a stable manifest with distinct seeds for every task episode."""
+    if episodes_per_task <= 0:
+        raise ValueError("episodes_per_task must be positive")
+    seed_population = range(1, 2**31 - 1)
+    tasks = {
+        task_name: _task_rng(base_seed, task_name).sample(seed_population, episodes_per_task)
+        for task_name in TASK_NAMES
+    }
+    manifest = {
+        "schema_version": 1,
+        "base_seed": base_seed,
+        "episodes_per_task": episodes_per_task,
+        "generator": "sha256(base_seed:task_name) -> Python random.sample(range(1, 2**31-1))",
+        "task_order": list(TASK_NAMES),
+        "tasks": tasks,
+    }
+    validate_manifest(manifest, expected_episodes=episodes_per_task)
+    return manifest
+
+
+def validate_manifest(manifest: dict[str, Any], expected_episodes: int | None = None) -> None:
+    """Raise ValueError when a seed manifest cannot drive a fair 24-task evaluation."""
+    if manifest.get("schema_version") != 1:
+        raise ValueError(f"Unsupported seed manifest schema: {manifest.get('schema_version')!r}")
+    task_order = manifest.get("task_order")
+    tasks = manifest.get("tasks")
+    if task_order != list(TASK_NAMES):
+        raise ValueError("Seed manifest task_order does not match the canonical 24-task order")
+    if not isinstance(tasks, dict) or set(tasks) != set(TASK_NAMES):
+        raise ValueError("Seed manifest must contain exactly the canonical 24 tasks")
+    episode_count = expected_episodes or manifest.get("episodes_per_task")
+    if not isinstance(episode_count, int) or episode_count <= 0:
+        raise ValueError("Invalid episodes_per_task in seed manifest")
+    for task_name in TASK_NAMES:
+        seeds = tasks[task_name]
+        if len(seeds) != episode_count:
+            raise ValueError(f"{task_name} has {len(seeds)} seeds, expected {episode_count}")
+        if len(set(seeds)) != len(seeds):
+            raise ValueError(f"{task_name} contains duplicate episode seeds")
+        if not all(isinstance(seed, int) and 0 < seed < 2**31 - 1 for seed in seeds):
+            raise ValueError(f"{task_name} contains an invalid seed")
+
+
+def load_manifest(path: str | Path, expected_episodes: int | None = None) -> dict[str, Any]:
+    with Path(path).open(encoding="utf-8") as file:
+        manifest = json.load(file)
+    validate_manifest(manifest, expected_episodes=expected_episodes)
+    return manifest
+
+
+def save_manifest(manifest: dict[str, Any], path: str | Path) -> Path:
+    output_path = Path(path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    with output_path.open("w", encoding="utf-8") as file:
+        json.dump(manifest, file, indent=2)
+        file.write("\n")
+    return output_path
+
+
+def take_first(manifest: dict[str, Any], count: int) -> dict[str, Any]:
+    """Return a validated prefix manifest, useful for exact-seed smoke tests."""
+    validate_manifest(manifest)
+    if not 0 < count <= manifest["episodes_per_task"]:
+        raise ValueError(f"count must be in [1, {manifest['episodes_per_task']}]")
+    subset = dict(manifest)
+    subset["episodes_per_task"] = count
+    subset["tasks"] = {task: list(manifest["tasks"][task][:count]) for task in TASK_NAMES}
+    subset["source_episodes_per_task"] = manifest["episodes_per_task"]
+    validate_manifest(subset, expected_episodes=count)
+    return subset
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path)
+    parser.add_argument("--input", type=Path)
+    parser.add_argument("--base-seed", type=int, default=20260819)
+    parser.add_argument("--episodes-per-task", type=int, default=50)
+    parser.add_argument("--take-first", type=int)
+    parser.add_argument("--list-tasks", action="store_true")
+    args = parser.parse_args()
+    if args.list_tasks:
+        print("\n".join(TASK_NAMES))
+        return
+    if args.output is None:
+        parser.error("--output is required unless --list-tasks is used")
+    if args.input is not None:
+        manifest = load_manifest(args.input)
+        if args.take_first is not None:
+            manifest = take_first(manifest, args.take_first)
+    else:
+        if args.take_first is not None:
+            parser.error("--take-first requires --input")
+        manifest = generate_manifest(args.base_seed, args.episodes_per_task)
+    output = save_manifest(manifest, args.output)
+    print(output)
+
+
+if __name__ == "__main__":
+    main()
