@@ -0,0 +1,136 @@
+"""Merge two fixed-seed result shards and audit their rollout videos."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+from examples.Robocasa_tabletop.eval_files.seed_manifest import load_manifest
+
+
+def read_result(path: Path) -> dict:
+    with path.open(encoding="utf-8") as file:
+        return json.load(file)
+
+
+def write_atomic(path: Path, payload: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    with temporary.open("w", encoding="utf-8") as file:
+        json.dump(payload, file, indent=2)
+        file.write("\n")
+    os.replace(temporary, path)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--run-root", type=Path, required=True)
+    parser.add_argument("--seed-manifest", type=Path, required=True)
+    parser.add_argument("--split", type=int, default=25)
+    parser.add_argument("--output-results-subdir", default="results_merged")
+    args = parser.parse_args()
+
+    manifest = load_manifest(args.seed_manifest)
+    total_episodes = manifest["episodes_per_task"]
+    if not 0 < args.split < total_episodes:
+        raise ValueError("split must be strictly inside the manifest episode range")
+
+    report = {
+        "tasks": {},
+        "complete_videos": 0,
+        "unfinalized_completed_videos": 0,
+        "video_result_success_mismatches": 0,
+        "partial_videos": 0,
+    }
+    matched_video_paths: set[Path] = set()
+    for task_name in manifest["task_order"]:
+        task_slug = task_name.split("/", 1)[1]
+        first = read_result(args.run_root / "results" / f"{task_slug}.json")
+        second = read_result(args.run_root / "results_shard25" / f"{task_slug}.json")
+        first_records = first["episodes"]
+        second_records = second["episodes"]
+        expected_seeds = manifest["tasks"][task_name]
+        actual_seeds = [record["seed"] for record in first_records + second_records]
+        if len(first_records) != args.split or len(second_records) != total_episodes - args.split:
+            raise ValueError(f"Incomplete result shards for {task_name}")
+        if actual_seeds != expected_seeds:
+            raise ValueError(f"Seed order mismatch for {task_name}")
+        expected_indices = list(range(total_episodes))
+        actual_indices = [record["episode_index"] for record in first_records + second_records]
+        if actual_indices != expected_indices:
+            raise ValueError(f"Episode index mismatch for {task_name}: {actual_indices}")
+
+        merged_records = first_records + second_records
+        successes = sum(bool(record["success"]) for record in merged_records)
+        merged = {
+            "env_name": task_name,
+            "n_episodes": total_episodes,
+            "completed_episodes": total_episodes,
+            "successes": successes,
+            "success_rate": successes / total_episodes,
+            "episodes": merged_records,
+        }
+        write_atomic(
+            args.run_root / args.output_results_subdir / f"{task_slug}.json", merged
+        )
+
+        task_video_count = 0
+        task_unfinalized_completed_videos = 0
+        task_video_result_mismatches = 0
+        for record in merged_records:
+            episode_index = record["episode_index"]
+            video_root = "videos" if episode_index < args.split else "videos_shard25"
+            video_prefix = (
+                args.run_root
+                / video_root
+                / task_slug
+                / f"episode_{episode_index:03d}_seed_{record['seed']}"
+            )
+            candidates = [
+                Path(str(video_prefix) + "_success0.mp4"),
+                Path(str(video_prefix) + "_success1.mp4"),
+                Path(str(video_prefix) + ".mp4"),
+            ]
+            completed = [path for path in candidates if path.is_file() and path.stat().st_size > 0]
+            if len(completed) != 1:
+                raise FileNotFoundError(
+                    f"Expected exactly one completed rollout video for {video_prefix}, got {completed}"
+                )
+            video_success = completed[0].name.endswith("_success1.mp4")
+            matched_video_paths.add(completed[0])
+            is_unfinalized = completed[0].name == video_prefix.name + ".mp4"
+            if is_unfinalized:
+                task_unfinalized_completed_videos += 1
+            elif video_success != bool(record["success"]):
+                task_video_result_mismatches += 1
+            task_video_count += 1
+        report["complete_videos"] += task_video_count
+        report["unfinalized_completed_videos"] += task_unfinalized_completed_videos
+        report["video_result_success_mismatches"] += task_video_result_mismatches
+        report["tasks"][task_name] = {
+            "episodes": total_episodes,
+            "successes": successes,
+            "complete_videos": task_video_count,
+            "unfinalized_completed_videos": task_unfinalized_completed_videos,
+            "video_result_success_mismatches": task_video_result_mismatches,
+        }
+
+    partials = []
+    for video_root in ("videos", "videos_shard25"):
+        for path in (args.run_root / video_root).glob("**/*.mp4"):
+            if (
+                "_success0.mp4" not in path.name
+                and "_success1.mp4" not in path.name
+                and path not in matched_video_paths
+            ):
+                partials.append(str(path))
+    report["partial_videos"] = len(partials)
+    report["partial_video_paths"] = partials
+    write_atomic(args.run_root / "merge_audit.json", report)
+    print(json.dumps({k: v for k, v in report.items() if k != "tasks"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
