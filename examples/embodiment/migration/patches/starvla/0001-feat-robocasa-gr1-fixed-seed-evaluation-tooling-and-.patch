@@ -0,0 +1,67 @@
+"""Fully decode fixed-seed rollout videos and report corrupt files."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import multiprocessing
+import os
+from pathlib import Path
+
+import av
+
+
+def decode_video(path_string: str) -> tuple[str, int, str | None]:
+    path = Path(path_string)
+    try:
+        with av.open(path) as container:
+            frame_count = sum(1 for _ in container.decode(video=0))
+        if frame_count <= 0:
+            raise ValueError("video contains no decoded frames")
+        return path_string, frame_count, None
+    except Exception as error:  # noqa: BLE001 - audit must record every decoder failure
+        return path_string, 0, repr(error)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--run-root", type=Path, required=True)
+    parser.add_argument("--workers", type=int, default=24)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    paths = sorted(
+        str(path)
+        for root in (args.run_root / "videos", args.run_root / "videos_shard25")
+        for path in root.glob("**/*.mp4")
+    )
+    with multiprocessing.Pool(args.workers) as pool:
+        decoded = pool.map(decode_video, paths)
+    failures = [
+        {"path": path, "error": error}
+        for path, _, error in decoded
+        if error is not None
+    ]
+    frame_counts = [count for _, count, error in decoded if error is None]
+    report = {
+        "video_count": len(paths),
+        "decoded_video_count": len(frame_counts),
+        "failure_count": len(failures),
+        "min_frames": min(frame_counts) if frame_counts else 0,
+        "max_frames": max(frame_counts) if frame_counts else 0,
+        "total_frames": sum(frame_counts),
+        "failures": failures,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    temporary = args.output.with_suffix(args.output.suffix + ".tmp")
+    with temporary.open("w", encoding="utf-8") as file:
+        json.dump(report, file, indent=2)
+        file.write("\n")
+    os.replace(temporary, args.output)
+    print(json.dumps(report, indent=2))
+    if failures:
+        raise RuntimeError(f"{len(failures)} rollout videos failed full decoding")
+
+
+if __name__ == "__main__":
+    main()
