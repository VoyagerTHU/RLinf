diff --git a/examples/Robocasa_tabletop/run_fixed_seed_eval.sh b/examples/Robocasa_tabletop/run_fixed_seed_eval.sh
new file mode 100755
index 0000000..1fac303
--- /dev/null
+++ b/examples/Robocasa_tabletop/run_fixed_seed_eval.sh
@@ -0,0 +1,176 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+cd "${REPO_ROOT}"
+
+STARVLA_PYTHON=${STARVLA_PYTHON:-/data/dengyixuan/wyz/.venvs/starvla-cve/bin/python}
+ROBOCASA_PYTHON=${ROBOCASA_PYTHON:-/data/dengyixuan/wyz/.venvs/robocasa-gr1-cve/bin/python}
+CHECKPOINT_PATH=${1:?Usage: $0 CHECKPOINT_PATH [RUN_ROOT]}
+RUN_ROOT=${2:-/data/dengyixuan/wyz/experiments/starvla_robocasa_gr1/$(date +%Y%m%d_%H%M%S)}
+SEED_MANIFEST=${SEED_MANIFEST:-/data/dengyixuan/wyz/experiments/starvla_robocasa_gr1/seeds_24x50_base20260819.json}
+N_EPISODES=${N_EPISODES:-50}
+MAX_EPISODE_STEPS=${MAX_EPISODE_STEPS:-720}
+N_ACTION_STEPS=${N_ACTION_STEPS:-12}
+NUM_GPUS=${NUM_GPUS:-8}
+NUM_WORKERS=${NUM_WORKERS:-${NUM_GPUS}}
+PHYSICAL_GPUS=${PHYSICAL_GPUS:-${NUM_GPUS}}
+BASE_PORT=${BASE_PORT:-6398}
+RECORD_VIDEO=${RECORD_VIDEO:-1}
+POLICY_TRANSPORT=${POLICY_TRANSPORT:-file}
+START_POLICY_SERVERS=${START_POLICY_SERVERS:-1}
+SERVER_ONLY=${SERVER_ONLY:-0}
+SIM_SET_CUDA_VISIBLE_DEVICES=${SIM_SET_CUDA_VISIBLE_DEVICES:-0}
+SEED_OFFSET=${SEED_OFFSET:-0}
+RESULTS_SUBDIR=${RESULTS_SUBDIR:-results}
+VIDEOS_SUBDIR=${VIDEOS_SUBDIR:-videos}
+LOGS_SUBDIR=${LOGS_SUBDIR:-logs}
+SKIP_SUMMARY=${SKIP_SUMMARY:-0}
+export PYTHONHASHSEED=${PYTHONHASHSEED:-0}
+export MUJOCO_GL=${MUJOCO_GL:-egl}
+export TORCH_HOME=${TORCH_HOME:-/data/dengyixuan/wyz/.cache/torch}
+export HF_HOME=${HF_HOME:-/data/dengyixuan/wyz/huggingface}
+export VBENCH_CACHE_DIR=${VBENCH_CACHE_DIR:-/data/dengyixuan/wyz/.cache/vbench}
+export MPLCONFIGDIR=${MPLCONFIGDIR:-/data/dengyixuan/wyz/.cache/matplotlib}
+export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}
+export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-1}
+export MKL_NUM_THREADS=${MKL_NUM_THREADS:-1}
+export NUMEXPR_NUM_THREADS=${NUMEXPR_NUM_THREADS:-1}
+export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
+
+mkdir -p "${RUN_ROOT}/${LOGS_SUBDIR}" "${RUN_ROOT}/${RESULTS_SUBDIR}" "${RUN_ROOT}/bridge" "${MPLCONFIGDIR}"
+if [[ ! -f "${SEED_MANIFEST}" ]]; then
+    python examples/Robocasa_tabletop/eval_files/seed_manifest.py \
+        --output "${SEED_MANIFEST}" \
+        --episodes-per-task "${N_EPISODES}"
+fi
+RUN_MANIFEST="${RUN_ROOT}/seed_manifest.json"
+if [[ -f "${RUN_MANIFEST}" ]]; then
+    cmp --silent "${SEED_MANIFEST}" "${RUN_MANIFEST}" || {
+        echo "Seed manifest differs from the one already frozen in ${RUN_ROOT}" >&2
+        exit 1
+    }
+else
+    cp "${SEED_MANIFEST}" "${RUN_MANIFEST}"
+fi
+SEED_MANIFEST="${RUN_MANIFEST}"
+
+mapfile -t TASKS < <(python examples/Robocasa_tabletop/eval_files/seed_manifest.py --list-tasks)
+SERVER_PIDS=()
+EVAL_PIDS=()
+
+cleanup() {
+    for pid in "${EVAL_PIDS[@]:-}"; do
+        kill "${pid}" 2>/dev/null || true
+    done
+    for pid in "${SERVER_PIDS[@]:-}"; do
+        kill "${pid}" 2>/dev/null || true
+    done
+}
+trap cleanup EXIT INT TERM
+
+if [[ "${START_POLICY_SERVERS}" == "1" ]]; then
+    for ((worker = 0; worker < NUM_WORKERS; worker++)); do
+        gpu=$((worker % PHYSICAL_GPUS))
+        port=$((BASE_PORT + worker))
+        bridge_dir="${RUN_ROOT}/bridge/worker${worker}"
+        mkdir -p "${bridge_dir}"
+        server_transport_args=()
+        if [[ "${POLICY_TRANSPORT}" == "file" ]]; then
+            server_transport_args=(--file_bridge_dir "${bridge_dir}")
+        fi
+        CUDA_VISIBLE_DEVICES=${gpu} "${STARVLA_PYTHON}" deployment/model_server/server_policy.py \
+            --ckpt_path "${CHECKPOINT_PATH}" \
+            --port "${port}" \
+            --use_bf16 \
+            "${server_transport_args[@]}" \
+            > "${RUN_ROOT}/${LOGS_SUBDIR}/server_worker${worker}_gpu${gpu}_port${port}.log" 2>&1 &
+        SERVER_PIDS+=("$!")
+    done
+fi
+
+SERVER_READY_TIMEOUT=${SERVER_READY_TIMEOUT:-600}
+for ((worker = 0; worker < NUM_WORKERS; worker++)); do
+    gpu=$((worker % PHYSICAL_GPUS))
+    port=$((BASE_PORT + worker))
+    pid=${SERVER_PIDS[worker]:-}
+    deadline=$((SECONDS + SERVER_READY_TIMEOUT))
+    bridge_dir="${RUN_ROOT}/bridge/worker${worker}"
+    until { [[ "${POLICY_TRANSPORT}" == "file" && -f "${bridge_dir}/metadata.msgpack" ]] || \
+            { [[ "${POLICY_TRANSPORT}" != "file" ]] && (echo > "/dev/tcp/127.0.0.1/${port}") 2>/dev/null; }; }; do
+        if [[ "${START_POLICY_SERVERS}" == "1" ]] && ! kill -0 "${pid}" 2>/dev/null; then
+            echo "Policy server worker ${worker} on GPU ${gpu} exited before becoming ready" >&2
+            tail -n 100 "${RUN_ROOT}/${LOGS_SUBDIR}/server_worker${worker}_gpu${gpu}_port${port}.log" >&2 || true
+            exit 1
+        fi
+        if ((SECONDS >= deadline)); then
+            echo "Timed out waiting for policy server on GPU ${gpu}, port ${port}" >&2
+            exit 1
+        fi
+        sleep 5
+    done
+done
+
+if [[ "${SERVER_ONLY}" == "1" ]]; then
+    if [[ "${START_POLICY_SERVERS}" != "1" ]]; then
+        echo "SERVER_ONLY=1 requires START_POLICY_SERVERS=1" >&2
+        exit 1
+    fi
+    echo "All policy servers are ready under ${RUN_ROOT}/bridge"
+    wait
+    exit 0
+fi
+
+for ((batch_start = 0; batch_start < ${#TASKS[@]}; batch_start += NUM_WORKERS)); do
+    EVAL_PIDS=()
+    for ((worker = 0; worker < NUM_WORKERS; worker++)); do
+        task_index=$((batch_start + worker))
+        if ((task_index >= ${#TASKS[@]})); then
+            break
+        fi
+        task=${TASKS[task_index]}
+        task_slug=${task#*/}
+        gpu=$((worker % PHYSICAL_GPUS))
+        port=$((BASE_PORT + worker))
+        video_args=()
+        if [[ "${RECORD_VIDEO}" == "1" ]]; then
+            mkdir -p "${RUN_ROOT}/${VIDEOS_SUBDIR}/${task_slug}"
+            video_args=(--args.video_out_path "${RUN_ROOT}/${VIDEOS_SUBDIR}/${task_slug}")
+        fi
+        eval_env_args=()
+        if [[ "${SIM_SET_CUDA_VISIBLE_DEVICES}" == "1" ]]; then
+            eval_env_args+=(CUDA_VISIBLE_DEVICES=${gpu})
+        fi
+        if [[ "${POLICY_TRANSPORT}" == "file" ]]; then
+            eval_env_args+=(STARVLA_FILE_BRIDGE_DIR=${RUN_ROOT}/bridge/worker${worker})
+        fi
+        env "${eval_env_args[@]}" "${ROBOCASA_PYTHON}" \
+            examples/Robocasa_tabletop/eval_files/simulation_env.py \
+            --args.env_name "${task}" \
+            --args.port "${port}" \
+            --args.n_episodes "${N_EPISODES}" \
+            --args.n_envs 1 \
+            --args.max_episode_steps "${MAX_EPISODE_STEPS}" \
+            --args.n_action_steps "${N_ACTION_STEPS}" \
+            --args.pretrained_path "${CHECKPOINT_PATH}" \
+            --args.seed_manifest_path "${SEED_MANIFEST}" \
+            --args.seed_offset "${SEED_OFFSET}" \
+            --args.result_out_path "${RUN_ROOT}/${RESULTS_SUBDIR}/${task_slug}.json" \
+            "${video_args[@]}" \
+            > "${RUN_ROOT}/${LOGS_SUBDIR}/eval_${task_slug}_worker${worker}_gpu${gpu}.log" 2>&1 &
+        EVAL_PIDS+=("$!")
+    done
+    for pid in "${EVAL_PIDS[@]}"; do
+        wait "${pid}"
+    done
+done
+
+if [[ "${SKIP_SUMMARY}" != "1" ]]; then
+    "${ROBOCASA_PYTHON}" examples/Robocasa_tabletop/eval_files/summarize_fixed_seed_results.py \
+        --results-dir "${RUN_ROOT}/${RESULTS_SUBDIR}" \
+        --seed-manifest "${SEED_MANIFEST}" \
+        --output "${RUN_ROOT}/summary.json"
+fi
+
+echo "Evaluation complete: ${RUN_ROOT}"
