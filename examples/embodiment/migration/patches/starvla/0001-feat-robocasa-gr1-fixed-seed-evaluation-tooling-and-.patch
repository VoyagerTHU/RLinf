diff --git a/deployment/model_server/tools/file_policy_server.py b/deployment/model_server/tools/file_policy_server.py
new file mode 100644
index 0000000..1703489
--- /dev/null
+++ b/deployment/model_server/tools/file_policy_server.py
@@ -0,0 +1,44 @@
+"""Filesystem transport for policy inference when local sockets are unavailable."""
+
+from __future__ import annotations
+
+import os
+import time
+from pathlib import Path
+
+from . import msgpack_numpy
+from .websocket_policy_server import WebsocketPolicyServer
+
+
+class FilePolicyServer:
+    """Serve the same policy protocol through atomic files in a shared directory."""
+
+    def __init__(self, policy, bridge_dir: str | Path, metadata: dict | None = None):
+        self.bridge_dir = Path(bridge_dir)
+        self.bridge_dir.mkdir(parents=True, exist_ok=True)
+        self._router = WebsocketPolicyServer(policy=policy, metadata=metadata)
+        self._packer = msgpack_numpy.Packer()
+        self._write_atomic("metadata.msgpack", self._packer.pack(metadata or {}))
+
+    def _write_atomic(self, name: str, payload: bytes) -> None:
+        destination = self.bridge_dir / name
+        temporary = destination.with_suffix(destination.suffix + f".tmp.{os.getpid()}")
+        temporary.write_bytes(payload)
+        os.replace(temporary, destination)
+
+    def serve_forever(self) -> None:
+        while True:
+            requests = sorted(self.bridge_dir.glob("request.*.msgpack"))
+            if not requests:
+                time.sleep(0.002)
+                continue
+            for request_path in requests:
+                request_id = request_path.name.removeprefix("request.").removesuffix(".msgpack")
+                try:
+                    message = msgpack_numpy.unpackb(request_path.read_bytes())
+                    response = self._router._route_message(message)
+                finally:
+                    request_path.unlink(missing_ok=True)
+                self._write_atomic(
+                    f"response.{request_id}.msgpack", self._packer.pack(response)
+                )
